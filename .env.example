# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Session pooler (port 5432) — used by the app on Vercel.
# Not the transaction pooler (6543): it hangs when a page runs queries in parallel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Session pooler (port 5432) — used to run migrations
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Email alerts for new quote requests (https://resend.com) — optional ──
RESEND_API_KEY=
EMAIL_FROM="Ecram Execs <bookings@your-verified-domain.nl>"
NOTIFY_EMAIL_TO=you@example.com

# Public URL of the site, used for links in alert emails
SITE_URL=https://ecram-execs.vercel.app

# Random string used to anonymise visitor IPs for rate limiting (openssl rand -hex 32)
IP_HASH_SALT=

# Optional: RDW open data app token, gives licence-plate checks for driver applications priority
# over anonymous traffic. Free at https://opendata.rdw.nl (sign in → Developer Settings → Create New App Token)
RDW_APP_TOKEN=
