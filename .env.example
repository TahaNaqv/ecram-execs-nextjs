# ── Database (Supabase → Project Settings → Database → Connection string) ──
# Session pooler (port 5432) — used by the app on Vercel.
# Not the transaction pooler (6543): it hangs when a page runs queries in parallel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Session pooler (port 5432) — used to run migrations
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Driver application documents ──
# Optional in development: with neither option below, the application form skips the document uploads.
# OPTION A — files on this server's disk (production on a VPS). A folder the app user owns (mode 700), outside the
# git checkout. Uploads and admin downloads go through the app's own /api/documents routes; links are signed with
# IP_HASH_SALT (or DOCUMENTS_SECRET, if you prefer a separate secret). Back this folder up with the database.
DOCUMENTS_DIR=
# OPTION B — Supabase Storage (used only when DOCUMENTS_DIR is empty). Supabase → Project Settings → API Keys.
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# A secret key (sb_secret_…) or the legacy service_role key. Server-side only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Then create the private bucket once: npm run storage:setup

# ── Email alerts and confirmations — optional; skipped and logged if no provider is set ──
# Production: Resend (https://resend.com), needs a verified domain. Takes priority over SMTP when set.
RESEND_API_KEY=
# Only for tests: a stand-in for Resend's endpoint (the e2e email spec starts one). Leave unset anywhere real.
# RESEND_API_URL=http://127.0.0.1:4599/emails
# Demos without a domain: Gmail SMTP. SMTP_PASS is a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords), not the normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# With Resend: an address on the verified domain. With Gmail: the SMTP_USER address.
EMAIL_FROM="Ecram Execs <bookings@your-verified-domain.nl>"
NOTIFY_EMAIL_TO=you@example.com

# Public URL of the site, used for links in alert emails
SITE_URL=https://ecram-execs.vercel.app

# Random string used to anonymise visitor IPs for rate limiting (openssl rand -hex 32)
IP_HASH_SALT=

# Optional: RDW open data app token, gives licence-plate checks for driver applications priority
# over anonymous traffic. Free at https://opendata.rdw.nl (sign in → Developer Settings → Create New App Token)
RDW_APP_TOKEN=

# Corporate Partner area: signs the six-digit emailed codes. Required there; without it no code can be issued.
# Generate with: openssl rand -hex 32
CORPORATE_OTP_SECRET=

# Optional: KvK (Dutch Chamber of Commerce) API key for the company search in the booking forms.
# Without it the company field is a plain text box. Request one at https://developers.kvk.nl
KVK_API_KEY=

# Optional: Google Maps Platform key for address suggestions in the booking flow (Places API (New) only; restrict the
# key to that API and set a budget alert). Without it the address fields suggest from our own short list of airports
# and stations, and anything else is typed in by hand.
GOOGLE_MAPS_API_KEY=

# Optional: the website concierge answers free-form questions with Claude when this is set; without it, it answers
# from the questions already on the page. Anyone can ask the chat, so keep an eye on usage (the endpoint is rate limited).
ANTHROPIC_API_KEY=
# Optional: the model that writes those replies (default claude-haiku-5-5). Set it to switch model without a code change, then restart the app.
CONCIERGE_MODEL=

# Optional: the number (digits only, with country code, e.g. 31612345678) behind the WhatsApp button and the concierge's
# hand-off. The button is hidden when it is not set; the chat falls back to the number in lib/site-config.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: "smtp" to send through SMTP even when a Resend key is present (otherwise Resend wins)
EMAIL_PROVIDER=
